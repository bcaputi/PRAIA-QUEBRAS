# Copie para .env.local e cole a connection string do Neon
DATABASE_URL="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Chave pra assinar o cookie de sessão (login por PIN) — qualquer string longa e
# aleatória, gerada uma vez e nunca compartilhada. Ex.: `openssl rand -hex 32`.
# Trocar essa chave invalida todas as sessões ativas (todo mundo precisa logar de novo).
SESSION_SECRET="troque-por-uma-string-aleatoria-longa"
